# LINKER - Environment Configuration Template
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────
# SUPABASE (Database + Auth)
# ─────────────────────────────────────────
# Find these in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database connection string (PostgreSQL) for Prisma ORM
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────
# Primary: Groq (fast, free tier available)
# Get your key at: https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Fallback: OpenRouter (Claude, GPT-4, etc.)
# Get your key at: https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ─────────────────────────────────────────
# LINKEDIN PUBLISHING INTEGRATION
# ─────────────────────────────────────────
# Needed for publishing approved drafts to LinkedIn:
# Create an app at: https://developer.linkedin.com/apps
# Required product: Share on LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/integrations/linkedin/callback"

# ─────────────────────────────────────────
# APP URL
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────
# CRON SECURITY
# ─────────────────────────────────────────
# Set a random secret to protect the /api/cron/publish endpoint.
CRON_SECRET="your-random-cron-secret-here"
